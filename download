# ==========================================================================
# Kairos Origin — Serverkonfiguration
# Gilt fuer Apache-Webspace (der Normalfall bei europaeischen Anbietern).
# Laeuft die Seite auf nginx oder GitHub Pages, wird diese Datei ignoriert;
# HTTPS ist dort ohnehin voreingestellt.
# ==========================================================================

# ---- Immer HTTPS, immer ohne www ----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Nur EINE Adresse soll bei Google stehen. Nach dem Umzug auf die eigene
  # Domain diese zwei Zeilen aktivieren (das # am Anfang entfernen):
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Sicherheitskopfzeilen ----------------------------------------------
<IfModule mod_headers.c>
  # Browser sollen die Seite zwei Jahre lang nur ueber HTTPS aufrufen
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  # Kein Erraten von Dateitypen
  Header always set X-Content-Type-Options "nosniff"
  # Die Seite darf nicht in fremde Rahmen eingebettet werden (Clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Beim Wechsel auf fremde Seiten nur die Domain uebermitteln, nicht die URL
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Kamera, Mikrofon, Standort, Bezahldienste werden nicht benoetigt
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # Fremde Fenster duerfen nicht auf unsere Seite zugreifen
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Inhaltsregeln: die Seite darf ausschliesslich eigene Dateien laden.
  # Das blockiert eingeschleusten Fremdcode zuverlaessig. Wird spaeter ein
  # externer Dienst eingebaut (Schriften, Karte, Statistik), muss dessen
  # Adresse hier ergaenzt werden — sonst laedt er nicht.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # Auslieferungs-Serversoftware nicht verraten
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ---- Zwischenspeicher ----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---- Komprimierung -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain application/xml
</IfModule>

# ---- Verzeichnisse nicht auflisten --------------------------------------
Options -Indexes
ServerSignature Off

# ---- Interne Dateien sperren --------------------------------------------
<FilesMatch "\.(md|bak|log|ini|sql|yml|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- Zeichensatz ---------------------------------------------------------
AddDefaultCharset UTF-8
