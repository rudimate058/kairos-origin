# ==========================================================================
# Kairos Origin — Serverkonfiguration
# Gilt fuer Apache-Webspace (der Normalfall bei europaeischen Anbietern).
# Laeuft die Seite auf nginx oder GitHub Pages, wird diese Datei ignoriert;
# HTTPS ist dort ohnehin voreingestellt.
# ==========================================================================

# ---- Immer HTTPS ---------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Sicherheitskopfzeilen ----------------------------------------------
<IfModule mod_headers.c>
  # Browser sollen die Seite ein Jahr lang nur ueber HTTPS aufrufen
  Header always set Strict-Transport-Security "max-age=31536000"
  # Kein Erraten von Dateitypen
  Header always set X-Content-Type-Options "nosniff"
  # Die Seite darf nicht in fremde Rahmen eingebettet werden (Clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Beim Wechsel auf fremde Seiten nur die Domain uebermitteln, nicht die URL
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Kamera, Mikrofon und Standort werden nicht benoetigt
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Zwischenspeicher ----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ---- Komprimierung -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

# ---- Verzeichnisse nicht auflisten --------------------------------------
Options -Indexes
